#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <100>;
    delay-ms = <0>;
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
        tap-ms = <100>;
    };

    behaviors {
        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };

        rsr_trans: rsr_trans {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <0>;
        };
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <14 28 40>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer0 {
            display-name = "L0";
            bindings = <
&kp ESCAPE        &kp N1            &kp N2        &kp N3        &kp N4    &kp N5       &kp UP       &kp N6     &kp N7     &kp N8     &kp N9           &kp N0      &kp BACKSLASH
&kp TAB           &kp Q             &kp W         &kp E         &kp R     &kp T        &kp DOWN     &kp Y      &kp U      &kp I      &kp O            &kp P       &kp BACKSPACE
&kp LEFT_SHIFT    &kp A             &kp S         &kp D         &kp F     &kp G        &kp LEFT     &kp H      &kp J      &kp K      &kp L            &kp SEMI    &kp SQT
&kp LEFT_CONTROL  &kp Z             &kp X         &kp C         &kp V     &kp B        &kp RIGHT    &kp N      &kp M      &kp COMMA  &kp PERIOD       &kp SLASH   &kp DELETE
&kp C_PLAY_PAUSE  &kp LEFT_BRACKET  &kp RIGHT_BRACKET &kp LEFT_ALT &kp LEFT_GUI &kp SPACE &none   &kp RETURN &mo 1      &kp BACKSPACE &none          &rgb_ug RGB_TOG
            >;
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        layer_1 {
            display-name = "L1";
            bindings = <
&kp GRAVE         &kp F1            &kp F2          &kp F3           &kp F4           &kp F5             &mmv MOVE_UP     &kp F6           &kp F7           &kp F8      &kp F9     &kp F10           &kp F11
&trans            &trans            &trans          &trans           &trans           &trans             &mmv MOVE_DOWN   &kp PAGE_UP      &kp PAGE_DOWN    &kp HOME    &kp END    &kp INS           &kp F12
&trans            &trans            &trans          &trans           &trans           &trans             &mmv MOVE_LEFT   &kp LEFT         &kp DOWN         &kp UP      &kp RIGHT  &trans            &trans
&trans            &trans            &trans          &trans           &trans           &trans             &mmv MOVE_RIGHT  &kp MINUS        &kp EQUAL        &rgb_ug RGB_SPD &rgb_ug RGB_SPI &rgb_ug RGB_EFF &kp PRINTSCREEN
&tog 2            &kp C_BRI_DN      &kp C_BRI_UP    &trans           &trans           &trans             &mkp LCLK        &trans           &trans           &trans      &rgb_ug RGB_BRD &rgb_ug RGB_BRI
            >;
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        layer_2 {
            display-name = "L2";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp W   &trans  &trans  &trans    &trans  &trans  &trans  &kp UP  &trans  &trans  &trans
&trans  &kp A   &kp S   &kp D   &trans  &trans    &trans  &trans  &kp LEFT &kp DOWN &kp RIGHT &trans &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
            >;
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        layer_3 {
            display-name = "L3";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
            >;
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        layer_4 {
            display-name = "L4";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
            >;
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };
    };
};
